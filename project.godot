; Engine configuration file.
; Crazy Cage Football (Godot 4 3D)
; Phase 1: Scaffolding & Core Loop

config_version=5

[application]

config/name="Crazy Cage Football"
config/version="0.2.1"
config/description="3D Physics Cage Soccer Game in Godot 4 inspired by Zippir: Kafes Futbolu. Roll, jump (Ziplama) and score bank-shot goals!"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[locale]

translations=PackedStringArray("res://i18n/translations.de.translation", "res://i18n/translations.en.translation")
locale/test="de"
locale/fallback="en"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true

[input]

p1_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65)] ; A
}
p1_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68)] ; D
}
p1_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":87)] ; W
}
p1_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83)] ; S
}
p1_jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32), Object(InputEventKey,"keycode":81)] ; Space or Q (Ziplama)
}
p1_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194325)] ; Left Shift
}

p2_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319)] ; Left Arrow
}
p2_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321)] ; Right Arrow
}
p2_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320)] ; Up Arrow
}
p2_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322)] ; Down Arrow
}
p2_jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194326)] ; Enter or Right Shift
}
p2_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194327)] ; Right Ctrl
}

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":80)] ; P
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":82)] ; R
}
